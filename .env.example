# Optional: set to "true" to disable Vite hot reload and file watching.
DISABLE_HMR=false

# Dev only (npm run dev): where /api/public/* (booking API) is proxied. Defaults to http://127.0.0.1:5051.
# Production does not use this: nginx serves dist/ and forwards /api/public/ itself. On a dev PC, point it at your local PMS:
# PMS_API_TARGET=http://localhost:5050
